# Set these in Portainer's stack environment; use distinct secrets per host.
LITELLM_MASTER_KEY=sk-replace-with-a-long-random-secret
LITELLM_SALT_KEY=sk-replace-with-a-different-long-random-secret
N8N_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
POSTGRES_PASSWORD=replace-with-another-long-random-secret

# Absolute path on the Docker host to the copied Open WebUI state directory.
# Example for this checkout: /home/mina/projects/github.com/skunkbandit-2/inference-work-shop/data/open-webui
OPEN_WEBUI_DATA=/absolute/path/to/inference-work-shop/data/open-webui
N8N_DATA=/absolute/path/to/inference-work-shop/data/n8n
